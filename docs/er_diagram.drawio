        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    DEPARTMENTS {\n        NUMBER department_id PK \&quot;NN\&quot;\n        VARCHAR2(100) department_name UK \&quot;NN\&quot;\n        VARCHAR2(100) office_location\n        TIMESTAMP created_at \&quot;NN\&quot;\n    }\n\n    STUDENTS {\n        NUMBER student_id PK \&quot;NN\&quot;\n        VARCHAR2(50) first_name \&quot;NN\&quot;\n        VARCHAR2(50) last_name \&quot;NN\&quot;\n        VARCHAR2(150) email UK \&quot;NN\&quot;\n        DATE date_of_birth\n        DATE admission_date \&quot;NN\&quot;\n        VARCHAR2(20) student_status \&quot;NN, CK\&quot;\n        NUMBER department_id FK \&quot;NN\&quot;\n    }\n\n    INSTRUCTORS {\n        NUMBER instructor_id PK \&quot;NN\&quot;\n        VARCHAR2(50) first_name \&quot;NN\&quot;\n        VARCHAR2(50) last_name \&quot;NN\&quot;\n        VARCHAR2(150) email UK \&quot;NN\&quot;\n        DATE hire_date\n        NUMBER department_id FK \&quot;NN\&quot;\n    }\n\n    COURSES {\n        NUMBER course_id PK \&quot;NN\&quot;\n        VARCHAR2(20) course_code UK \&quot;NN\&quot;\n        VARCHAR2(150) course_title \&quot;NN\&quot;\n        NUMBER credits \&quot;NN, CK\&quot;\n        NUMBER department_id FK \&quot;NN\&quot;\n    }\n\n    COURSE_PREREQUISITES {\n        NUMBER course_id PK, FK \&quot;NN\&quot;\n        NUMBER prerequisite_course_id PK, FK \&quot;NN\&quot;\n    }\n\n    SEMESTERS {\n        NUMBER semester_id PK \&quot;NN\&quot;\n        VARCHAR2(50) semester_name \&quot;NN\&quot;\n        VARCHAR2(9) academic_year \&quot;NN\&quot;\n        DATE start_date \&quot;NN\&quot;\n        DATE end_date \&quot;NN, CK\&quot;\n    }\n\n    COURSE_SECTIONS {\n        NUMBER section_id PK \&quot;NN\&quot;\n        NUMBER course_id FK \&quot;NN\&quot;\n        NUMBER semester_id FK \&quot;NN\&quot;\n        NUMBER instructor_id FK \&quot;NN\&quot;\n        VARCHAR2(10) section_number \&quot;NN\&quot;\n        NUMBER capacity \&quot;NN, CK\&quot;\n        VARCHAR2(50) classroom\n    }\n\n    ENROLLMENTS {\n        NUMBER enrollment_id PK \&quot;NN\&quot;\n        NUMBER student_id FK \&quot;NN\&quot;\n        NUMBER section_id FK \&quot;NN\&quot;\n        DATE enrollment_date \&quot;NN\&quot;\n        VARCHAR2(20) enrollment_status \&quot;NN, CK\&quot;\n        NUMBER grade \&quot;CK\&quot;\n    }\n\n    DEPARTMENTS ||--o{ STUDENTS : \&quot;department_id\&quot;\n    DEPARTMENTS ||--o{ INSTRUCTORS : \&quot;department_id\&quot;\n    DEPARTMENTS ||--o{ COURSES : \&quot;department_id\&quot;\n    COURSES ||--o{ COURSE_SECTIONS : \&quot;course_id\&quot;\n    SEMESTERS ||--o{ COURSE_SECTIONS : \&quot;semester_id\&quot;\n    INSTRUCTORS ||--o{ COURSE_SECTIONS : \&quot;instructor_id\&quot;\n    STUDENTS ||--o{ ENROLLMENTS : \&quot;student_id\&quot;\n    COURSE_SECTIONS ||--o{ ENROLLMENTS : \&quot;section_id\&quot;\n    COURSES ||--o{ COURSE_PREREQUISITES : \&quot;course_id\&quot;\n    COURSES ||--o{ COURSE_PREREQUISITES : \&quot;prerequisite_course_id\&quot;&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="sPYcos6udfFYFBK3Sdj6-1">
